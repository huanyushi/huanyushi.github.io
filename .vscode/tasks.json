{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Jekyll: serve local",
      "type": "shell",
      "command": "bundle",
      "args": [
        "exec",
        "jekyll",
        "serve",
        "--config",
        "_config.yml,_config_local.yml",
        // "--livereload"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    }
  ]
}